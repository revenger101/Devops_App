# Copy to .env and fill in real values. .env is git-ignored; never commit it.

MYSQL_ROOT_PASSWORD=change-me-root

# one MySQL user per service (database-per-service)
AUTH_DB_PASSWORD=change-me-auth
PRODUCT_DB_PASSWORD=change-me-product
SUPPLIER_DB_PASSWORD=change-me-supplier
INVOICE_DB_PASSWORD=change-me-invoice

# HS256 signing key shared by auth-service (signs) and api-gateway (verifies). At least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# optional: creates an ADMIN user at first startup (self-registration only creates plain USER accounts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# front-end origin allowed by the gateway CORS policy
CORS_ALLOWED_ORIGINS=http://localhost:4200
